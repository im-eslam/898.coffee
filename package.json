{
  "name": "proj-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently --names \"API,UI\" --prefix-colors \"blue,magenta\" --kill-others \"php -S 0.0.0.0:8000 -t api\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:full": "npm run build && concurrently --names \"API,UI\" --prefix-colors \"blue,magenta\" --kill-others \"php -S 0.0.0.0:8000 -t api\" \"vite preview --host 0.0.0.0\"",
    "lint": "oxlint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@raddix/use-scroll-spy": "^0.1.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "vaul": "^1.1.2",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-oxlint": "^2.2.0"
  }
}
